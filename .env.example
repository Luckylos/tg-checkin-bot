# 从 https://my.telegram.org 获取
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# 必填：用户在本地生成后直接配置。不要在服务器上用手机号/验证码交互登录。
# 生成方式见 README 的“生成 TG_SESSION_STRING”。
TG_SESSION_STRING=

# 可选
CONFIG_PATH=/config/config.yml
CONFIG_RELOAD_SECONDS=60
LOG_LEVEL=INFO

# 控制面：允许哪些 Telegram 用户通过消息控制添加/删除/配置任务。
# 多个 user id 用逗号分隔。留空时只接受本账号自己发出的 outgoing 命令。
CONTROL_BOT_ENABLED=true
TG_ADMIN_IDS=
