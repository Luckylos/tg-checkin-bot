# 从 https://my.telegram.org 获取
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# 必填：用户在本地生成后直接配置。不要在服务器上用手机号/验证码交互登录。
# 生成方式见 README 的“生成 TG_SESSION_STRING”。
TG_SESSION_STRING=

# 可选
CONFIG_PATH=/config/config.yml
CONFIG_RELOAD_SECONDS=60
LOG_LEVEL=INFO

# 是否启用 Telegram 内控制命令；仅监听登录账号自身发出的 outgoing 命令。
CONTROL_BOT_ENABLED=true

# 多账号模式示例：config.yml 中配置 env_prefix: ALICE / BOB 时读取以下变量。
# 不要把真实 session 提交到 Git。
# ALICE_API_ID=123456
# ALICE_API_HASH=0123456789abcdef0123456789abcdef
# ALICE_SESSION_STRING=
# BOB_API_ID=123456
# BOB_API_HASH=0123456789abcdef0123456789abcdef
# BOB_SESSION_STRING=
