# 从 https://my.telegram.org 获取。
# config.yml 里每个账号通过 env_prefix 读取对应凭据。

MAIN_API_ID=123456
MAIN_API_HASH=0123456789abcdef0123456789abcdef
MAIN_SESSION_STRING=

# 可选第二账号；启用 config.yml 中 second 账号前再填写。
# SECOND_API_ID=123456
# SECOND_API_HASH=0123456789abcdef0123456789abcdef
# SECOND_SESSION_STRING=

CONFIG_PATH=/config/config.yml
CONFIG_RELOAD_SECONDS=60
LOG_LEVEL=INFO

# 是否启用 Telegram 内控制命令；仅监听登录账号自身发出的 outgoing 命令。
CONTROL_BOT_ENABLED=true
